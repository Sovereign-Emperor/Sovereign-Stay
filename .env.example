# Public contact options. These values are bundled into the frontend.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=

# Frontend may use only the Supabase project URL and publishable/anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Choose explicitly: "demo" enables browser-local sample data; "supabase"
# selects database-backed routes. Production builds with no mode configured
# block marketplace pages; never use demo mode for a production deployment.
VITE_DATA_MODE=

# This public flag only controls checkout UI. The server independently requires
# PAYMENT_ENABLED=true; both must be enabled for an explicitly approved sandbox.
VITE_PAYMENTS_ENABLED=false

# Configure PAYSTACK_SECRET_KEY and PAYMENT_AMOUNT_PERCENT as Edge Function
# secrets in Supabase, never in this frontend environment file.
