# Public contact options. These values are bundled into the frontend.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=

# Frontend may use only the Supabase project URL and publishable/anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Choose explicitly: "demo" enables browser-local sample data; "supabase"
# selects database-backed routes. Production builds with no mode configured
# block marketplace pages; never use demo mode for a production deployment.
VITE_DATA_MODE=

# Public Paystack key is safe for browser use; payment secret and amount
# percentage belong only in Supabase Edge Function secrets, never VITE_ vars.
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENT_AMOUNT_PERCENT=100

# Optional external services (configure only when integrated).
SENTRY_DSN=
RESEND_API_KEY=
