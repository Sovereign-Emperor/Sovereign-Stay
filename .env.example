# Public contact options. These values are bundled into the frontend.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=

# Frontend may use only the Supabase project URL and publishable/anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Choose explicitly: "demo" enables browser-local sample data; "supabase"
# requires real Supabase repositories and authenticated data access. Leave
# blank for production until the live data repositories are complete.
VITE_DATA_MODE=

# Public Paystack key is safe for browser use; payment secret belongs only in
# Supabase Edge Function secrets and must never use a VITE_ prefix.
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional external services (configure only when integrated).
SENTRY_DSN=
RESEND_API_KEY=
